# Every variable this repo reads. Nothing here is required to build or boot —
# the site is fully static and lib/env.ts carries a working default for the one
# runtime variable. Copy to .env.local only if you need to override something.
#
# When adding a variable: declare it in lib/env.ts AND here, in the same change.

# ---------------------------------------------------------------------------
# Runtime (read by the app)
# ---------------------------------------------------------------------------

# Canonical origin. Feeds metadataBase and the OG url (app/layout.tsx), the
# sitemap entry (app/sitemap.ts) and the robots.txt sitemap line (app/robots.ts).
#
# INLINED AT BUILD TIME, because the prefix is NEXT_PUBLIC_. One built artifact
# therefore serves exactly one origin: a Docker image built without this set
# emits production canonicals no matter where it runs, so Dokploy staging must
# pass it as a build ARG (see docs/deploy.md). Vercel production needs nothing —
# lib/env.ts already falls back to the value below.
NEXT_PUBLIC_SITE_URL=https://portfolio.rakawidjaja.com

# ---------------------------------------------------------------------------
# Tooling only (read by tests and gates, never by the app)
# ---------------------------------------------------------------------------

# Origin the test suites and gates run against — tests/homepage.mjs,
# tests/persona.mjs, scripts/check-a11y.mjs, scripts/check-budget.mjs.
# All four default to http://localhost:3000. Set it to point the same suites at
# a deployed origin, which is how the M8 done-condition is verified:
#   BASE_URL=https://portfolio.rakawidjaja.com npm run test:persona
BASE_URL=http://localhost:3000
